# ── Trader Vaults environment ─────────────────────────────────────────────
# Copy to .env for local dev. One .env at the repo root serves both the
# API (apps/api/src/env.ts reads it) and the web app (vite envDir).
#
# ── Railway (production) ───────────────────────────────────────────
# Trader Vaults deploys as ONE service: the Express API serves /api *and* the
# built React app from apps/web/dist. Set these in the Railway dashboard
# (Service → Variables) — do NOT commit a real .env, it is gitignored.
#
#   REQUIRED
#     DATABASE_URL        Postgres. Attach a Railway Postgres service and
#                         reference it: ${{Postgres.DATABASE_URL}}
#                         Production is Postgres; the SQLite below is dev-only.
#     NODE_ENV=production Turns on static serving of the web build.
#     VITE_PRIVY_APP_ID   Baked into the JS at BUILD time, not read at
#                         runtime — it must exist before `npm run build`,
#                         and changing it needs a redeploy. Omit only if
#                         you want the demo-auth fallback in production.
#
#   PROVIDED BY RAILWAY — do not set by hand
#     PORT                Injected; the server binds it (0.0.0.0).
#
#   STRONGLY RECOMMENDED (public RPCs rate-limit hard under real traffic)
#     MAINNET_RPC_URL     Keyed mainnet RPC (Helius et al) for wallet scans.
#     SOLANA_RPC_URL      Cluster the app trades against.
#     VAULT_PROGRAM_ID    Deployed vault program address.
#
#   OPTIONAL
#     SERVE_STATIC        Force static serving on (1) or off (0),
#                         independent of NODE_ENV. Unset = follow NODE_ENV.
#     HOST                Bind address. Defaults to 0.0.0.0 — leave it.
#     JUPITER_API_KEY / BIRDEYE_API_KEY / HELIUS_API_KEY / REDIS_URL
#     I_UNDERSTAND_LIVE_TRADING_RISKS — mainnet execution gate.
#
# NOTE for local dev: `npm run build` generates the Prisma client against
# the PRODUCTION (Postgres) schema. After building locally, restore the
# SQLite client with `npm run db:generate:dev` before `npm run dev`.

# ── Database ───────────────────────────────────────────────────────
# Dev default is SQLite (zero setup). Production uses Postgres — the
# provider swap is automatic (scripts/prisma-prod.mjs), you only set the
# URL: DATABASE_URL="postgresql://user:pass@host:5432/trader_vaults"
DATABASE_URL="file:./dev.db"

# ── Server ─────────────────────────────────────────────────────────
# Local API port. Railway injects PORT and that always wins.
PORT=8787
# development | production. production makes the API serve apps/web/dist.
NODE_ENV=development
# SERVE_STATIC=1

# Optional Redis. Absent → in-memory TTL cache (fine for dev).
# REDIS_URL="redis://localhost:6379"

# ── Auth ───────────────────────────────────────────────────────────
# Privy (https://dashboard.privy.io → create app → App ID).
# Absent → web runs in demo-auth mode with a fake local user.
# VITE_PRIVY_APP_ID="clxxxxxxxxxxxxx"
# PRIVY_APP_SECRET="..."

# ── Price data ─────────────────────────────────────────────────────
# Jupiter Price v3 works keyless at low rate; add a key from portal.jup.ag
# for real rate limits. Birdeye optional.
# JUPITER_API_KEY="..."
# BIRDEYE_API_KEY="..."

# ── Solana ─────────────────────────────────────────────────────────
# Cluster the app trades against (devnet default).
SOLANA_RPC_URL="https://api.devnet.solana.com"
# Mainnet reads (wallet scans, token holders). Keyless works but
# rate-limits; Helius or similar recommended in production.
MAINNET_RPC_URL="https://api.mainnet-beta.solana.com"
# Comma-separated pool overriding the built-in fallback list.
# MAINNET_RPC_URLS="https://...,https://..."
# Deployed vault program address (programs/vault/PROGRAM_ID.txt).
# VAULT_PROGRAM_ID="..."
# SOLANA_CLUSTER="devnet"

# ── Fee escrow ─────────────────────────────────────────────────────
# Platform-controlled wallet holding the VESTED third of each trader's
# performance fee for 60 days before they can claim it. Generate a
# DEDICATED keypair — never reuse the server/deployer key:
#   solana-keygen new -o .keys/fee-escrow.json
# Put the PUBKEY here (it is public). The secret stays in .keys/, which
# is gitignored. Unset → the API records tranches with no destination
# and says so in /api/vested rather than pretending one exists.
# FEE_ESCROW_WALLET="..."

# Mainnet execution gate — the ibkr convention. Never set casually.
# I_UNDERSTAND_LIVE_TRADING_RISKS="yes"

# ── Browser-facing Solana config ───────────────────────────────────
# Which cluster Privy's embedded-wallet UI should treat as home. Privy
# defaults to mainnet-beta; without this its confirm modal shows mainnet
# balances while the program lives on devnet. The API (/api/onchain/config)
# stays the authority — this only shapes Privy's own UI.
VITE_SOLANA_CLUSTER="devnet"

# RPC the BROWSER uses. Deliberately separate from SOLANA_RPC_URL: the
# server's endpoint may carry an API key and must never be shipped to a
# client. Leave unset to use the public devnet endpoint.
# PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# Wallet that deploys pump.fun tokens, so creator rewards accrue to it.
# MUST be separate from FEE_ESCROW_WALLET: different money, different owner,
# and mixing them makes distributions impossible to reconcile.
CREATOR_REWARDS_WALLET=""
CREATOR_REWARDS_KEYPAIR_PATH=".keys/creator-rewards.json"
