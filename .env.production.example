# ── Production Environment Variables for Railway Deployment ──────
# Copy this to Railway environment variables or .env.production.local

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/trader_vaults_prod?sslmode=require

# ── Solana ───────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
VAULT_PROGRAM_ID=HWssGCcxUdiqeEiWk3CRxuSJy6eb4aZH7g2ubo7w6Sqc
SERVER_KEYPAIR_BASE64=<base64-encoded-server-keypair>

# ── Privy ───────────────────────────────────────────────────────────────
PRIVY_APP_ID=<privy-app-id>
PRIVY_APP_SECRET=<privy-app-secret>

# ── External APIs ───────────────────────────────────────────────────────
JUPITER_API_KEY=<jupiter-api-key-optional>
BIRDEYE_API_KEY=<birdeye-api-key>
HELIUS_API_KEY=<helius-api-key>

# ── Platform ───────────────────────────────────────────────────────────
PLATFORM_ADDRESS=<platform-treasury-address>
PLATFORM_FEE_BPS=1000

# ── Security ───────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=https://your-domain.com

# ── Features ───────────────────────────────────────────────────────────
ENABLE_MIRROR_TRADING=true
ENABLE_LIMIT_ORDERS=true
ENABLE_DCA=true
ENABLE_LEADERBOARDS=true

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
