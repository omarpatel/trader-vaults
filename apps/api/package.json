{
  "name": "@trader-vaults/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trader Vaults API — Express + Prisma (SQLite dev / Postgres prod), multi-tier price oracle, seeded demo data.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:generate": "prisma generate",
    "analyze": "node --inspect node_modules/.bin/tsx src/index.ts",
    "profile": "node --prof --no-log-file-per-isolate --log-dir=v8-logs node_modules/.bin/tsx src/index.ts"
  },
  "dependencies": {
    "@trader-vaults/shared": "*",
    "@prisma/client": "^6.7.0",
    "@solana/web3.js": "^1.98.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^6.2.10",
    "compression": "^1.7.4",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "prisma": "^6.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
